
{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true
  },
  "include": [
    "apps/api/src/**/*.ts",
    "apps/whatsapp-bot/src/**/*.ts",
    "services/**/*.ts",
    "packages/**/*.ts"
  ],
  "exclude": ["node_modules", "apps/web"]
}
